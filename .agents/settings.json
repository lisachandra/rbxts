{
	"includeCoAuthoredBy": true,
	"permissions": {
		"allow": [
			"execute_command(gh:*)",
			"execute_command(gh pr:*)",
			"execute_command(gh pr create:*)",
			"execute_command(gh pr view:*)",
			"execute_command(gh run list:*)",
			"execute_command(gh run view:*)",
			"Glob",
			"Grep",
			"LS",
			"Read",
			"Read(*)",
			"TodoWrite",
			"WebFetch",
			"WebSearch"
		],
		"deny": [],
		"ask": [],
		"defaultMode": "plan",
		"additionalDirectories": []
	},
	"enabledPlugins": {
		"sentinel@isentinel": true
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "execute_command",
				"hooks": [
					{
						"type": "command",
						"command": ".agents/hooks/run-hook.cmd enforce-pnpm"
					},
					{
						"type": "command",
						"command": ".agents/hooks/run-hook.cmd enforce-pnpm-scripts"
					},
					{
						"type": "command",
						"command": ".agents/hooks/run-hook.cmd enforce-safe-git"
					},
					{
						"type": "command",
						"command": ".agents/hooks/run-hook.cmd block-destructive-commands"
					}
				]
			}
		]
	},
	"outputStyle": "sentinel:XP Programmer"
}
