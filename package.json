{
	"name": "rbxts",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "COLUMNS=${COLUMNS:-$(tput cols 2>/dev/null || echo 80)} FORCE_COLOR=1 pnpm -r --parallel --stream test",
		"dev": "pnpm -r --parallel run dev",
		"clean": "pnpm --parallel run clean",
		"serve": "pnpm -r --parallel run serve",
		"build": "node ./scripts/build.mjs --scope all",
		"build:packages": "node ./scripts/build.mjs --scope packages",
		"build:test": "node ./scripts/build.mjs --scope test",
		"dev:packages": "pnpm --filter --parallel \"./packages/**\" dev",
		"dev:test": "pnpm --filter --parallel \"./test/**\" dev",
		"release": "pnpm -r publish --access=public && changeset tag",
		"version": "changeset version",
		"postinstall": "node ./scripts/hoist.mjs && node ./scripts/prepare.mjs"
	},
	"devDependencies": {
		"@lisachandra/types": "workspace:*",
		"@changesets/changelog-github": "catalog:",
		"@changesets/cli": "catalog:",
		"@isentinel/jest-roblox": "catalog:",
		"roblox-ts": "catalog:",
		"@isentinel/tsconfig": "catalog:",
		"@rbxts/compiler-types": "catalog:",
		"@rbxts/types": "catalog:",
		"husky": "catalog:",
		"io-serve": "catalog:",
		"shx": "catalog:",
		"typescript": "catalog:",
		"jiti": "catalog:"
	},
	"packageManager": "pnpm@10.33.0"
}
