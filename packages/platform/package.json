{
	"name": "@lisachandra/platform",
	"version": "0.1.0",
	"description": "Platform integrations (documents, teleporter, centurion, startup glue) for @lisachandra",
	"keywords": ["roblox", "rbxts", "platform"],
	"homepage": "https://github.com/lisachandra/rbxts",
	"bugs": {
		"url": "https://github.com/lisachandra/rbxts/issues"
	},
	"repository": {
		"url": "https://github.com/lisachandra/rbxts",
		"type": "git"
	},
	"license": "MIT",
	"author": "lisachandra <lisachandra@proton.me>",
	"private": false,
	"type": "module",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./out/init.luau",
			"types": "./out/index.d.ts"
		},
		"./bootstrap": {
			"source": "./src/bootstrap.ts",
			"import": "./out/bootstrap.luau",
			"types": "./out/bootstrap.d.ts"
		},
		"./centurion/type": {
			"source": "./src/centurion/type.ts",
			"import": "./out/centurion/type.luau",
			"types": "./out/centurion/type.d.ts"
		},
		"./centurion/guards": {
			"source": "./src/centurion/guards.ts",
			"import": "./out/centurion/guards.luau",
			"types": "./out/centurion/guards.d.ts"
		},
		"./centurion/commands": {
			"source": "./src/centurion/commands/index.ts",
			"import": "./out/centurion/commands/init.luau",
			"types": "./out/centurion/commands/index.d.ts"
		},
		"./centurion/types": {
			"source": "./src/centurion/types/index.ts",
			"import": "./out/centurion/types/init.luau",
			"types": "./out/centurion/types/index.d.ts"
		},
		"./centurion/utility": {
			"source": "./src/centurion/utility.ts",
			"import": "./out/centurion/utility.luau",
			"types": "./out/centurion/utility.d.ts"
		},
		"./teleporter": {
			"source": "./src/teleporter.ts",
			"import": "./out/teleporter.luau",
			"types": "./out/teleporter.d.ts"
		},
		"./document": {
			"source": "./src/document/index.ts",
			"import": "./out/document/init.luau",
			"types": "./out/document/index.d.ts"
		}
	},
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"files": ["out", "default.project.json", "!**/*.tsbuildinfo"],
	"scripts": {
		"prepare": "node ../../scripts/prepare.mjs || pnpm run build",
		"build": "shx rm -rf out && rbxtsc --verbose --allowCommentDirectives",
		"dev": "rbxtsc --watch --allowCommentDirectives",
		"clean": "shx rm -rf out"
	},
	"devDependencies": {
		"@lisachandra/types": "workspace:*",
		"roblox-ts": "catalog:",
		"@isentinel/tsconfig": "catalog:",
		"@rbxts/compiler-types": "catalog:",
		"@rbxts/types": "catalog:",
		"shx": "catalog:",
		"@lisachandra/matter": "workspace:*",
		"@lisachandra/core": "workspace:*",
		"@rbxts/lapis-mockdatastore": "catalog:",
		"@rbxts/centurion": "catalog:",
		"@rbxts/services": "catalog:",
		"@rbxts/log": "catalog:",
		"@rbxts/lapis": "catalog:",
		"@rbxts/sift": "catalog:",
		"@flamework/core": "catalog:",
		"@rbxts/object-utils": "catalog:",
		"@rbxts/t": "catalog:",
		"@rbxts/serio": "catalog:",
		"@rbxts/regexp": "catalog:",
		"@rbxts/matter": "catalog:",
		"@rbxts/luau-polyfill": "catalog:",
		"@rbxts/rbxts-hashlib": "catalog:",
		"type-fest": "catalog:",
		"rbxts-transformer-flamework": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@lisachandra/types": "*",
		"@lisachandra/matter": "*",
		"@lisachandra/core": "*",
		"@flamework/core": "*",
		"@rbxts/rbxts-hashlib": "*",
		"@rbxts/object-utils": "*",
		"@rbxts/t": "*",
		"@rbxts/serio": "*",
		"@rbxts/regexp": "*",
		"@rbxts/matter": "*",
		"@rbxts/lapis-mockdatastore": "*",
		"@rbxts/centurion": "*",
		"@rbxts/services": "*",
		"@rbxts/log": "*",
		"@rbxts/lapis": "*",
		"@rbxts/sift": "*",
		"type-fest": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
