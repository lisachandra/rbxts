{
	"name": "@lisachandra/core",
	"version": "0.1.0",
	"description": "Core runtime, utilities, logger, and shared primitives for @lisachandra rbxts packages",
	"keywords": ["roblox", "rbxts", "core"],
	"homepage": "https://github.com/lisachandra/rbxts",
	"bugs": {
		"url": "https://github.com/lisachandra/rbxts/issues"
	},
	"repository": {
		"url": "https://github.com/lisachandra/rbxts",
		"type": "git"
	},
	"license": "MIT",
	"author": "lisachandra <lisachandra@proton.me>",
	"private": false,
	"type": "module",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./out/index.luau",
			"types": "./out/index.d.ts"
		}
	},
	"main": "out/index.luau",
	"types": "out/index.d.ts",
	"files": ["out", "default.project.json", "!**/*.tsbuildinfo"],
	"scripts": {
		"build": "shx rm -rf out && rbxtsc --verbose --allowCommentDirectives",
		"dev": "shx rm -rf out && rbxtsc --watch --allowCommentDirectives",
		"clean": "shx rm -rf out"
	},
	"devDependencies": {
		"@isentinel/roblox-ts": "catalog:",
		"@rbxts/compiler-types": "catalog:",
		"@rbxts/types": "catalog:",
		"shx": "catalog:"
	},
	"peerDependencies": {
		"@rbxts/log": "catalog:"
	},
	"publishConfig": {
		"access": "public"
	}
}
