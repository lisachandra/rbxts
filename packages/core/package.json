{
	"name": "@lisachandra/core",
	"version": "0.1.1",
	"private": false,
	"description": "Core runtime, utilities, logger, and shared primitives for @lisachandra rbxts packages",
	"keywords": [
		"core",
		"rbxts",
		"roblox"
	],
	"homepage": "https://github.com/lisachandra/rbxts",
	"bugs": {
		"url": "https://github.com/lisachandra/rbxts/issues"
	},
	"license": "MIT",
	"author": "lisachandra <lisachandra@proton.me>",
	"repository": {
		"type": "git",
		"url": "https://github.com/lisachandra/rbxts"
	},
	"files": [
		"out",
		"README.md",
		"default.project.json",
		"!**/*.tsbuildinfo"
	],
	"type": "module",
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"exports": {
		".": {
			"import": "./out/init.luau",
			"types": "./out/index.d.ts"
		},
		"./logger": {
			"import": "./out/logger.luau",
			"types": "./out/logger.d.ts"
		},
		"./store": {
			"import": "./out/store.luau",
			"types": "./out/store.d.ts"
		},
		"./schemas": {
			"import": "./out/schemas/init.luau",
			"types": "./out/schemas/index.d.ts"
		},
		"./utils/asset": {
			"import": "./out/utils/asset.luau",
			"types": "./out/utils/asset.d.ts"
		},
		"./utils/cframe": {
			"import": "./out/utils/cframe.luau",
			"types": "./out/utils/cframe.d.ts"
		},
		"./utils/color": {
			"import": "./out/utils/color.luau",
			"types": "./out/utils/color.d.ts"
		},
		"./utils/formatTable": {
			"import": "./out/utils/formatTable.luau",
			"types": "./out/utils/formatTable.d.ts"
		},
		"./utils/main": {
			"import": "./out/utils/main.luau",
			"types": "./out/utils/main.d.ts"
		},
		"./utils/math": {
			"import": "./out/utils/math.luau",
			"types": "./out/utils/math.d.ts"
		},
		"./utils/r6ik": {
			"import": "./out/utils/r6ik.luau",
			"types": "./out/utils/r6ik.d.ts"
		},
		"./utils/string": {
			"import": "./out/utils/string.luau",
			"types": "./out/utils/string.d.ts"
		},
		"./utils/type": {
			"import": "./out/utils/type.luau",
			"types": "./out/utils/type.d.ts"
		},
		"./utils/vector": {
			"import": "./out/utils/vector.luau",
			"types": "./out/utils/vector.d.ts"
		},
		"./utils/vfx": {
			"import": "./out/utils/vfx.luau",
			"types": "./out/utils/vfx.d.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "shx rm -rf out && rbxtsc --verbose --allowCommentDirectives",
		"dev": "rbxtsc --watch --allowCommentDirectives",
		"clean": "shx rm -rf out flamework.build .jest-roblox",
		"prepare": "node ../../scripts/prepare.mjs"
	},
	"devDependencies": {
		"@flamework/core": "catalog:",
		"@isentinel/roblox-ts": "catalog:",
		"@isentinel/tsconfig": "catalog:",
		"@lisachandra/types": "workspace:*",
		"@rbxts/centurion": "catalog:",
		"@rbxts/compiler-types": "catalog:",
		"@rbxts/crate": "catalog:",
		"@rbxts/lapis": "catalog:",
		"@rbxts/lemon-signal": "catalog:",
		"@rbxts/log": "catalog:",
		"@rbxts/luau-polyfill": "catalog:",
		"@rbxts/matter": "catalog:",
		"@rbxts/message-templates": "catalog:",
		"@rbxts/object-cache": "catalog:",
		"@rbxts/services": "catalog:",
		"@rbxts/sift": "catalog:",
		"@rbxts/t": "catalog:",
		"@rbxts/types": "catalog:",
		"@rbxts/validate-tree": "catalog:",
		"shx": "catalog:",
		"type-fest": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@flamework/core": "*",
		"@lisachandra/types": "*",
		"@rbxts/centurion": "*",
		"@rbxts/crate": "*",
		"@rbxts/lapis": "*",
		"@rbxts/lemon-signal": "*",
		"@rbxts/log": "*",
		"@rbxts/luau-polyfill": "*",
		"@rbxts/matter": "*",
		"@rbxts/message-templates": "*",
		"@rbxts/object-cache": "*",
		"@rbxts/services": "*",
		"@rbxts/sift": "*",
		"@rbxts/t": "*",
		"@rbxts/validate-tree": "*",
		"type-fest": "*"
	}
}
