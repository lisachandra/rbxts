{
	"name": "@lisachandra/matter",
	"version": "0.1.0",
	"description": "Matter runtime, hooks, components, and systems composition for @lisachandra",
	"keywords": [
		"roblox",
		"rbxts",
		"matter",
		"ecs"
	],
	"homepage": "https://github.com/lisachandra/rbxts",
	"bugs": {
		"url": "https://github.com/lisachandra/rbxts/issues"
	},
	"repository": {
		"url": "https://github.com/lisachandra/rbxts",
		"type": "git"
	},
	"license": "MIT",
	"author": "lisachandra <lisachandra@proton.me>",
	"private": false,
	"type": "module",
	"exports": {
		".": {
			"import": "./out/init.luau",
			"types": "./out/index.d.ts"
		},
		"./packages": {
			"import": "./out/packages/init.luau",
			"types": "./out/packages/index.d.ts"
		},
		"./items": {
			"import": "./out/items/init.luau",
			"types": "./out/items/index.d.ts"
		},
		"./utils/item": {
			"import": "./out/utils/item.luau",
			"types": "./out/utils/item.d.ts"
		},
		"./utils/entity": {
			"import": "./out/utils/entity.luau",
			"types": "./out/utils/entity.d.ts"
		},
		"./utils/physics": {
			"import": "./out/utils/physics.luau",
			"types": "./out/utils/physics.d.ts"
		},
		"./utils/sound": {
			"import": "./out/utils/sound.luau",
			"types": "./out/utils/sound.d.ts"
		},
		"./systems": {
			"import": "./out/systems/init.luau",
			"types": "./out/systems/index.d.ts"
		},
		"./components": {
			"import": "./out/components.luau",
			"types": "./out/components.d.ts"
		}
	},
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"files": [
		"out",
		"README.md",
		"default.project.json",
		"!**/*.tsbuildinfo"
	],
	"scripts": {
		"build": "shx rm -rf out && rbxtsc --verbose --allowCommentDirectives",
		"dev": "rbxtsc --watch --allowCommentDirectives",
		"clean": "shx rm -rf out flamework.build",
		"prepare": "node ../../scripts/prepare.mjs"
	},
	"devDependencies": {
		"@lisachandra/types": "workspace:*",
		"@lisachandra/core": "workspace:*",
		"@lisachandra/constant": "catalog:",
		"@flamework/core": "catalog:",
		"@rbxts/t": "catalog:",
		"@rbxts/crate": "catalog:",
		"@rbxts/janitor": "catalog:",
		"@rbxts/lemon-signal": "catalog:",
		"@rbxts/services": "catalog:",
		"@rbxts/matter": "catalog:",
		"@rbxts/rewire": "catalog:",
		"@rbxts/tether": "catalog:",
		"@isentinel/roblox-ts": "catalog:",
		"@isentinel/tsconfig": "catalog:",
		"@rbxts/compiler-types": "catalog:",
		"@rbxts/types": "catalog:",
		"@rbxts/object-utils": "catalog:",
		"@rbxts/object-cache": "catalog:",
		"@rbxts/log": "catalog:",
		"@rbxts/luau-polyfill": "catalog:",
		"@rbxts/sift": "catalog:",
		"@rbxts/plasma": "catalog:",
		"@rbxts/lapis": "catalog:",
		"rbxts-transformer-flamework": "catalog:",
		"@rbxts/serio": "catalog:",
		"type-fest": "catalog:",
		"shx": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@lisachandra/types": "*",
		"@lisachandra/core": "*",
		"@lisachandra/constant": "*",
		"type-fest": "*",
		"@flamework/core": "*",
		"@rbxts/t": "*",
		"@rbxts/log": "*",
		"@rbxts/luau-polyfill": "*",
		"@rbxts/sift": "*",
		"@rbxts/serio": "*",
		"@rbxts/object-utils": "*",
		"@rbxts/object-cache": "*",
		"@rbxts/matter": "*",
		"@rbxts/rewire": "*",
		"@rbxts/crate": "*",
		"@rbxts/janitor": "*",
		"@rbxts/lemon-signal": "*",
		"@rbxts/tether": "*",
		"@rbxts/services": "*",
		"@rbxts/plasma": "*",
		"@rbxts/lapis": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
