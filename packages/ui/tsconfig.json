{
	"extends": "@isentinel/configs/roblox",
	"compilerOptions": {
		"jsx": "react",
		"jsxFactory": "React.createElement",
		"jsxFragmentFactory": "React.Fragment",
		"tsBuildInfoFile": "out/tsconfig.tsbuildinfo",
		"baseUrl": "src",
		"rootDir": "src",
		"typeRoots": ["../../node_modules/@rbxts", "../../node_modules/@types"],
		"outDir": "out"
	},
	"include": ["src/**/*"]
}
