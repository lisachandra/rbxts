{
	"name": "@lisachandra/ui",
	"version": "0.1.1",
	"description": "Reusable React UI components, hooks, and hot reload helpers for @lisachandra",
	"keywords": [
		"roblox",
		"rbxts",
		"react",
		"ui"
	],
	"homepage": "https://github.com/lisachandra/rbxts",
	"bugs": {
		"url": "https://github.com/lisachandra/rbxts/issues"
	},
	"repository": {
		"url": "https://github.com/lisachandra/rbxts",
		"type": "git"
	},
	"license": "MIT",
	"author": "lisachandra <lisachandra@proton.me>",
	"private": false,
	"type": "module",
	"exports": {
			".": {
				"import": "./out/init.luau",
				"types": "./out/index.d.ts"
			},
			"./hooks/useConstant": {
				"import": "./out/hooks/useConstant.luau",
				"types": "./out/hooks/useConstant.d.ts"
			},
			"./hooks/useProperty": {
				"import": "./out/hooks/useProperty.luau",
				"types": "./out/hooks/useProperty.d.ts"
			},
			"./hooks/usePropertyBinding": {
				"import": "./out/hooks/usePropertyBinding.luau",
				"types": "./out/hooks/usePropertyBinding.d.ts"
			},
			"./hooks/useComponentRecord": {
				"import": "./out/hooks/useComponentRecord.luau",
				"types": "./out/hooks/useComponentRecord.d.ts"
			},
			"./hooks/usePx": {
				"import": "./out/hooks/usePx.luau",
				"types": "./out/hooks/usePx.d.ts"
			},
			"./hooks/useWorldToScreen": {
				"import": "./out/hooks/useWorldToScreen.luau",
				"types": "./out/hooks/useWorldToScreen.d.ts"
			}
	},
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"files": [
		"out",
		"README.md",
		"default.project.json",
		"!**/*.tsbuildinfo"
	],
	"scripts": {
		"build": "shx rm -rf out && rbxtsc --verbose --allowCommentDirectives",
		"dev": "rbxtsc --watch --allowCommentDirectives",
		"clean": "shx rm -rf out flamework.build .jest-roblox",
		"prepare": "node ../../scripts/prepare.mjs"
	},
	"devDependencies": {
		"@lisachandra/types": "workspace:*",
		"@lisachandra/core": "workspace:*",
		"@lisachandra/matter": "workspace:*",
		"@lisachandra/react-template": "workspace:*",
		"@lisachandra/constant": "catalog:",
		"@isentinel/roblox-ts": "catalog:",
		"@isentinel/tsconfig": "catalog:",
		"@rbxts/compiler-types": "catalog:",
		"@rbxts/types": "catalog:",
		"@rbxts/react": "catalog:",
		"@rbxts/react-roblox": "catalog:",
		"@rbxts/rewire": "catalog:",
		"@rbxts/pretty-react-hooks": "catalog:",
		"@rbxts/services": "catalog:",
		"shx": "catalog:"
	},
	"peerDependencies": {
		"@lisachandra/types": "*",
		"@lisachandra/core": "*",
		"@lisachandra/matter": "*",
		"@lisachandra/react-template": "*",
		"@lisachandra/constant": "*",
		"@rbxts/pretty-react-hooks": "*",
		"@rbxts/services": "*",
		"@rbxts/react": "*",
		"@rbxts/react-roblox": "*",
		"@rbxts/rewire": "*"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
