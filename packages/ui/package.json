{
	"name": "@lisachandra/ui",
	"version": "0.1.0",
	"description": "Reusable React UI components, hooks, and hot reload helpers for @lisachandra",
	"keywords": [
		"roblox",
		"rbxts",
		"react",
		"ui"
	],
	"homepage": "https://github.com/lisachandra/rbxts",
	"bugs": {
		"url": "https://github.com/lisachandra/rbxts/issues"
	},
	"repository": {
		"url": "https://github.com/lisachandra/rbxts",
		"type": "git"
	},
	"license": "MIT",
	"author": "lisachandra <lisachandra@proton.me>",
	"private": false,
	"type": "module",
	"exports": {
		".": {
			"import": "./out/init.luau",
			"types": "./out/index.d.ts"
		}
	},
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"files": [
		"out",
		"README.md",
		"default.project.json",
		"!**/*.tsbuildinfo"
	],
	"scripts": {
		"build": "shx rm -rf out && rbxtsc --verbose --allowCommentDirectives",
		"dev": "rbxtsc --watch --allowCommentDirectives",
		"clean": "shx rm -rf out",
		"prepare": "node ../../scripts/prepare.mjs"
	},
	"devDependencies": {
		"@lisachandra/types": "workspace:*",
		"@lisachandra/core": "workspace:*",
		"@lisachandra/matter": "workspace:*",
		"@lisachandra/react-template": "workspace:*",
		"@lisachandra/constant": "catalog:",
		"@isentinel/roblox-ts": "catalog:",
		"@isentinel/tsconfig": "catalog:",
		"@rbxts/compiler-types": "catalog:",
		"@rbxts/types": "catalog:",
		"@rbxts/react": "catalog:",
		"@rbxts/react-roblox": "catalog:",
		"@rbxts/rewire": "catalog:",
		"@rbxts/pretty-react-hooks": "catalog:",
		"@rbxts/services": "catalog:",
		"shx": "catalog:"
	},
	"peerDependencies": {
		"@lisachandra/types": "*",
		"@lisachandra/core": "*",
		"@lisachandra/matter": "*",
		"@lisachandra/react-template": "*",
		"@lisachandra/constant": "*",
		"@rbxts/pretty-react-hooks": "*",
		"@rbxts/services": "*",
		"@rbxts/react": "*",
		"@rbxts/react-roblox": "*",
		"@rbxts/rewire": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
