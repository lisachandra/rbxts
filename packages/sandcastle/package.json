{
	"name": "@lisachandra/sandcastle",
	"version": "1.1.0",
	"description": "Three-phase agent issue runner (design → implement → review) with persistent worktrees, sequential issues, and integration composition",
	"keywords": [
		"agents",
		"cli",
		"github",
		"roblox-ts",
		"sandcastle",
		"worktrees"
	],
	"homepage": "https://github.com/lisachandra/rbxts",
	"bugs": {
		"url": "https://github.com/lisachandra/rbxts/issues"
	},
	"license": "MIT",
	"author": "lisachandra <lisachandra@proton.me>",
	"repository": {
		"type": "git",
		"url": "https://github.com/lisachandra/rbxts"
	},
	"bin": {
		"sandcastle": "dist/main.js"
	},
	"files": [
		"dist",
		"prompts",
		"assets",
		"README.md",
		"!**/*.tsbuildinfo"
	],
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"exports": {
		".": {
			"import": "./dist/main.js",
			"types": "./dist/main.d.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "shx rm -rf dist && tsc -p tsconfig.json && tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
		"dev": "tsc -p tsconfig.json --watch",
		"clean": "shx rm -rf dist .sandcastle .tmp",
		"web:build": "vite build --config web/vite.config.ts",
		"web:dev": "vite --config web/vite.config.ts",
		"test": "tsc -p tsconfig.test.json && vitest run",
		"test:coverage": "tsc -p tsconfig.test.json && vitest run --coverage",
		"prepare": "pnpm build"
	},
	"dependencies": {
		"@ai-hero/sandcastle": "catalog:",
		"jiti": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@dagrejs/dagre": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"@xyflow/react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"shx": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=20.12"
	}
}
