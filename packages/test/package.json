{
	"name": "@lisachandra/test",
	"version": "0.1.1",
	"private": false,
	"description": "Test utilities for @lisachandra rbxts packages",
	"keywords": [
		"rbxts",
		"roblox",
		"test"
	],
	"homepage": "https://github.com/lisachandra/rbxts",
	"bugs": {
		"url": "https://github.com/lisachandra/rbxts/issues"
	},
	"license": "MIT",
	"author": "lisachandra <lisachandra@proton.me>",
	"repository": {
		"type": "git",
		"url": "https://github.com/lisachandra/rbxts"
	},
	"files": [
		"out",
		"README.md",
		"default.project.json",
		"!**/*.tsbuildinfo"
	],
	"type": "module",
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"exports": {
		".": {
			"import": "./out/init.luau",
			"types": "./out/index.d.ts"
		},
		"./utils": {
			"import": "./out/utils.luau",
			"types": "./out/utils.d.ts"
		},
		"./setup": {
			"import": "./out/setup.luau",
			"types": "./out/setup.d.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "shx rm -rf out && rbxtsc --verbose --allowCommentDirectives",
		"dev": "rbxtsc --watch --allowCommentDirectives",
		"clean": "shx rm -rf out flamework.build .jest-roblox",
		"prepare": "node ../../scripts/prepare.mjs"
	},
	"devDependencies": {
		"@isentinel/roblox-ts": "catalog:",
		"@isentinel/tsconfig": "catalog:",
		"@lisachandra/types": "workspace:*",
		"@rbxts/compiler-types": "catalog:",
		"@rbxts/jest": "catalog:",
		"@rbxts/jest-globals": "catalog:",
		"@rbxts/luau-polyfill": "catalog:",
		"@rbxts/react": "catalog:",
		"@rbxts/react-roblox-fire": "catalog:",
		"@rbxts/react-testing-library": "catalog:",
		"@rbxts/services": "catalog:",
		"@rbxts/types": "catalog:",
		"shx": "catalog:",
		"type-fest": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@lisachandra/types": "*",
		"@rbxts/jest": "*",
		"@rbxts/jest-globals": "*",
		"@rbxts/luau-polyfill": "*",
		"@rbxts/react": "*",
		"@rbxts/react-roblox-fire": "*",
		"@rbxts/react-testing-library": "*",
		"@rbxts/services": "*",
		"@rbxts/types": "*",
		"type-fest": "*"
	}
}
