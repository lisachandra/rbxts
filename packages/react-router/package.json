{
	"name": "@lisachandra/react-router",
	"version": "1.0.1",
	"private": false,
	"description": "Client-side router for React Roblox",
	"keywords": [
		"rbxts",
		"react",
		"roblox",
		"router"
	],
	"homepage": "https://github.com/lisachandra/rbxts",
	"bugs": {
		"url": "https://github.com/lisachandra/rbxts/issues"
	},
	"license": "MIT",
	"author": "lisachandra <lisachandra@proton.me>",
	"repository": {
		"type": "git",
		"url": "https://github.com/lisachandra/rbxts"
	},
	"files": [
		"out",
		"README.md",
		"default.project.json",
		"!**/*.tsbuildinfo"
	],
	"type": "module",
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"exports": {
		".": {
			"import": "./out/init.luau",
			"types": "./out/index.d.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "shx rm -rf out && rbxtsc --verbose --allowCommentDirectives",
		"dev": "rbxtsc --watch --allowCommentDirectives",
		"clean": "shx rm -rf out flamework.build .jest-roblox",
		"prepare": "node ../../scripts/prepare.mjs"
	},
	"devDependencies": {
		"@isentinel/roblox-ts": "catalog:",
		"@isentinel/tsconfig": "catalog:",
		"@lisachandra/types": "workspace:*",
		"@rbxts/compiler-types": "catalog:",
		"@rbxts/lemon-signal": "catalog:",
		"@rbxts/react": "catalog:",
		"@rbxts/services": "catalog:",
		"@rbxts/types": "catalog:",
		"shx": "catalog:"
	},
	"peerDependencies": {
		"@lisachandra/types": "*",
		"@rbxts/lemon-signal": "*",
		"@rbxts/react": "*",
		"@rbxts/services": "*"
	}
}
