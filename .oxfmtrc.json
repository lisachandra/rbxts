{
	"arrowParens": "always",
	"printWidth": 100,
	"quoteProps": "consistent",
	"semi": true,
	"singleQuote": false,
	"tabWidth": 4,
	"trailingComma": "all",
	"useTabs": true,
	"endOfLine": "lf",
	"jsdoc": true,
	"sortImports": false,
	"sortPackageJson": true,
	"embeddedLanguageFormatting": "auto",
	"ignorePatterns": [
		".husky/install.mjs",
		"scripts/**",
		".agents/**",
		".diracrules/**",
		"submodules/**",
		"creator-docs/**",
		"**/out/**",
		"**/coverage/**",
		"**/.jest-roblox/**",
		".workspace-links/**",
		"**/pnpm-lock.yaml"
	],
	"overrides": [
		{
			"files": [".github/**/*.yaml"],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	]
}
